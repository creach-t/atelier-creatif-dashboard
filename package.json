{
  "name": "cashly",
  "version": "1.0.0",
  "description": "Cashly - Dashboard de gestion de ventes multi-canal (Ko-fi, point de vente) pour créatifs indépendants",
  "keywords": [
    "react",
    "dashboard",
    "e-commerce",
    "creative",
    "tailwind"
  ],
  "author": "Atelier Créatif",
  "license": "MIT",
  "proxy": "http://localhost:4000",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "compression": "^1.8.2",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "autoprefixer": "^10.4.14",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.263.1",
    "postcss": "^8.4.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.5.2",
    "react-scripts": "5.0.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.3.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "server": "node server.js",
    "dev": "concurrently -n web,api -c blue,magenta \"npm:start\" \"cross-env PORT=4000 node server.js\"",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": ["src/features/**/*.js", "src/app/**/*.js", "src/widgets/**/*.js", "src/ui/**/*.js", "src/App.js"],
        "rules": {
          "no-restricted-imports": ["error", {
            "patterns": [
              { "group": ["**/api/client", "**/api/supabaseClient", "@supabase/*"], "message": "Passer par src/services/ : seuls services/, data/ et api/ parlent au serveur ou à Supabase." }
            ]
          }]
        }
      },
      {
        "files": ["src/core/**/*.js"],
        "rules": {
          "no-restricted-imports": ["error", {
            "patterns": [
              { "group": ["**/features/**", "**/app/**", "**/widgets/index", "**/widgets/*Widget"], "message": "core/ est le moteur : il ne dépend pas des couches supérieures (features, app, widgets)." },
              { "group": ["**/api/client", "**/api/supabaseClient", "@supabase/*"], "message": "Passer par src/services/ : seuls services/, data/ et api/ parlent au serveur ou à Supabase." }
            ]
          }]
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
