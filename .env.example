# Copie ce fichier en .env.local pour le développement local (jamais commité).
# En production, ces variables vivent dans un fichier .env sur le VPS, à côté de
# docker-compose.prod.yml (voir DEPLOYMENT.md) — jamais transmises via le CI, sauf
# les deux REACT_APP_* ci-dessous qui doivent être des secrets GitHub (build-args Docker).

# Supabase — Project Settings > API Keys sur https://app.supabase.com
# Clé "secret" (sb_secret_...) ou "service_role" (legacy) — jamais exposée au navigateur.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cle_secrete_ici

# Mêmes Project Settings > API Keys — clé "publishable" (sb_publishable_...) ou "anon" (legacy).
# Safe à exposer au navigateur (RLS Postgres protège les données), utilisée par le front
# pour l'authentification Supabase Auth (login/signup). Doit être connue au build (Docker ARG).
REACT_APP_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=cle_publishable_ou_anon_ici
