# Copie ce fichier en .env.local pour le développement local (jamais commité).
# En production, ces variables vivent dans un fichier .env sur le VPS, à côté de
# docker-compose.prod.yml (voir DEPLOYMENT.md) — jamais transmises via le CI.

# Supabase — Project Settings > API Keys sur https://app.supabase.com (clé "secret", sb_secret_...,
# ou "service_role" si ton projet affiche encore l'ancien système — les deux marchent ici)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cle_secrete_ici

# Ko-fi — Page de création > Settings > API Webhooks
KOFI_VERIFICATION_TOKEN=ton_verification_token_kofi

# Clé d'accès au dashboard (choisis une valeur longue et aléatoire toi-même)
DASHBOARD_ACCESS_TOKEN=choisis-une-cle-secrete-longue
